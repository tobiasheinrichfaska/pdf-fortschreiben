{
  "name": "pdf-fortschreiben",
  "private": true,
  "version": "0.0.1",
  "description": "Append revisions to a PDF without rewriting it: associated files (PDF/A-3) and document time stamps (RFC 3161, PAdES ETSI.RFC3161), and read them back. No network, no dependencies.",
  "license": "AGPL-3.0-only",
  "author": "Tobias Heinrich",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "extern": "bash scripts/pki.sh && node scripts/extern-pruefen.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "pdf-lib": "1.17.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
